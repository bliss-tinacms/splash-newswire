---
const { data = {} } = Astro.props;
const hero = data.hero ?? {};
const leadership = data.leadership ?? {};
const seniorStaff = data.seniorStaff ?? {};
const leaders = Array.isArray(leadership.people) ? leadership.people : [];
const staff = Array.isArray(seniorStaff.people) ? seniorStaff.people : [];
---
<section class="team-template"><header class="team-ph"><div class="team-w"><div class="team-ph-kick"><i></i><span>{hero.eyebrow}</span></div><h1>{hero.headline}</h1><p class="team-ph-lede">{hero.lede}</p></div></header><section class="team-ld"><div class="team-w"><div class="team-sec-eye"><i></i><span>{leadership.eyebrow}</span></div><h2 class="team-sec-h">{leadership.title}</h2><div class="team-ld-g">{leaders.map((person) => (<article class="team-ld-c">{person.image && <img class="team-ld-img" src={person.image} alt={person.imageAlt || person.name || ''} />}<div><h3 class="team-ld-n">{person.name}</h3><div class="team-ld-r">{person.role}</div><div class="team-ld-loc" aria-label="Location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{person.location}</div><p class="team-ld-x">{person.bio}</p></div></article>))}</div></div></section><section class="team-ss"><div class="team-w"><div class="team-sec-eye"><i></i><span>{seniorStaff.eyebrow}</span></div><h2 class="team-sec-h">{seniorStaff.title}</h2><div class="team-ss-g">{staff.map((person) => (<article class="team-sc">{person.image && <img class="team-sc-img" src={person.image} alt={person.imageAlt || person.name || ''} />}<div class="team-sc-b"><h3 class="team-sc-n">{person.name}</h3><div class="team-sc-r">{person.role}</div><div class="team-sc-loc" aria-label="Location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{person.location}</div><p class="team-sc-x">{person.bio}</p></div></article>))}</div></div></section></section>
