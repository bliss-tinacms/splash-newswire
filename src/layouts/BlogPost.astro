---
import { Icon } from 'astro-icon/components';
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string | null;
	ogTitle?: string;
	ogDescription?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	nofollow?: boolean;
}

const { title, description, heroImage, ogTitle, ogDescription, canonicalUrl, noindex, nofollow } = Astro.props;
---

<Base
	title={title}
	description={description}
	image={heroImage ?? undefined}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	canonicalUrl={canonicalUrl}
	noindex={noindex}
	nofollow={nofollow}
>
	<div class="mx-auto max-w-4xl px-6 pt-8">
		<a
			href="/blog"
			class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
		>
			<Icon name="tabler:arrow-left" size={16} />
			Back to blog
		</a>
	</div>
	<slot />
</Base>
