---
import { listBlogs } from '../../../lib/data';

export const prerender = false;

type ReferenceObject = {
  title?: string | null;
  name?: string | null;
  _sys?: { filename?: string | null } | null;
};

function slugify(value?: string | null) {
  return String(value || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function slugFromReference(reference: unknown) {
  if (!reference) return null;
  if (typeof reference === 'string') {
    return slugify(reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '') || '');
  }
  if (typeof reference === 'object') {
    const item = reference as ReferenceObject;
    return slugify(item._sys?.filename || item.title || item.name || '');
  }
  return null;
}

function parseArchiveParam(value?: string) {
  const parts = String(value || '').toLowerCase().split('/').filter(Boolean);
  const pageIndex = parts.indexOf('page');
  if (pageIndex >= 0) {
    return {
      slug: parts.slice(0, pageIndex).join('/'),
      pageSuffix: '/page/' + (parts[pageIndex + 1] || '1'),
    };
  }
  return { slug: parts.join('/'), pageSuffix: '' };
}

export async function getStaticPaths() {
  const slugifyLocal = (value?: string | null) => String(value || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  const slugFromReferenceLocal = (reference: any) => {
    if (!reference) return null;
    if (typeof reference === 'string') {
      return slugifyLocal(reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '') || '');
    }
    return slugifyLocal(reference._sys?.filename || reference.title || reference.name || '');
  };

  const groups = new Set<string>();
  const categoryModules = import.meta.glob('../../../content/category/*.json', { eager: true });
  for (const [filePath, mod] of Object.entries(categoryModules)) {
    const filename = filePath.split('/').pop()?.replace(/\.json$/i, '') || '';
    const data = ((mod as any).default || mod || {}) as { title?: string; name?: string };
    const slug = slugifyLocal(filename || data.title || data.name || '');
    if (slug) groups.add(slug);
  }
  const counts = new Map<string, number>();
  const posts = await listBlogs();
  for (const post of posts) {
    const slug = slugFromReferenceLocal(post.category);
    if (!slug) continue;
    groups.add(slug);
    counts.set(slug, (counts.get(slug) || 0) + 1);
  }

  const paths: Array<{ params: { slug: string } }> = [];
  for (const slug of groups) {
    paths.push({ params: { slug } });
    const totalPages = Math.max(1, Math.ceil((counts.get(slug) || 0) / 30));
    for (let page = 2; page <= totalPages; page++) {
      paths.push({ params: { slug: slug + '/page/' + page } });
    }
  }
  return paths;
}

const parsed = parseArchiveParam(Astro.params.slug);
if (!parsed.slug) return new Response('Not Found', { status: 404 });
return Astro.redirect('/' + parsed.slug + parsed.pageSuffix + '/', 301);
---
