---
import { getBlogPermalink, getBlogRouteAliases, getBlogRouteSlug } from '../../lib/permalinks';
import { listBlogs } from '../../lib/data';

export const prerender = false;

export async function getStaticPaths() {
  const posts = await listBlogs();
  return posts.map((node) => ({
    params: { slug: getBlogRouteSlug(node) },
    props: { post: node },
  }));
}

const routeSlug = (Astro.params.slug ?? '').toString();
const allPosts = await listBlogs();
const post = Astro.props.post ?? allPosts.find((item) => getBlogRouteAliases(item).includes(routeSlug.toLowerCase()));

if (!post) return new Response('Not Found', { status: 404 });
return Astro.redirect(getBlogPermalink(post) + '/', 301);
---
