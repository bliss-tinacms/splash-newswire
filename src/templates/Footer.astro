---
import { tinaField } from "@tinacms/astro/tina-field";
import footerNavigation from '../content/navigation/footer.json';
import siteConfig from '../content/config/config.json';

const footerMenuItems = (footerNavigation.items || []).filter((item) => item && item.label && item.href);
const seo = siteConfig?.seo ?? null;

// Footer logo follows the same backend pattern as the header logo:
// Header uses seo.logo; footer uses seo.footerLogo and falls back to seo.logo.
const siteTitle = seo?.title || 'Splash Newswire';
const footerLogo = seo?.footerLogo || seo?.logo || '';
---

<footer class="foot">
  <div class="w">
    <div class="foot-hero">
      <div class="fh-l">
        {footerLogo ? (
          <img
            class="fh-logo"
            src={footerLogo}
            alt={siteTitle}
            data-tina-field={seo ? tinaField(seo, "footerLogo") : undefined}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="fh-wordmark" aria-label={siteTitle}>
            <span class="fh-mark" aria-hidden="true"></span>
            <span>{siteTitle}</span>
          </div>
        )}
        <p class="fh-p">Share news that matters. From company announcements and community developments to events and noteworthy updates, your story can start here.</p>
      </div>
      <div class="fh-r">
        <div class="fh-eye">Have news to share?</div>
        <p class="fh-h">Put Your Story on Our Radar</p>
        <p class="fh-x">Send your announcement, story tip, or noteworthy update to the Splash Newswire editorial team for review and editorial consideration.</p>
        <a href="/contact" class="fh-cta">Submit your news →</a>
      </div>
    </div>
  </div>

  <div class="w">
    <div class="foot-btm">
      <p>© 2026 Splash Newswire. Your news, everywhere it matters.</p>
      <nav class="foot-legal" aria-label={footerNavigation.title || 'Footer menu'}>
        {footerMenuItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
