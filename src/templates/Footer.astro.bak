---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig, CmsConfigFooterNav } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const footerNav = (config?.footerNav ?? []).filter(
	(item): item is CmsConfigFooterNav => item !== null,
);
const siteTitle = seo?.title || 'Harbor Post';
const [brandFirst, ...brandRestParts] = siteTitle.split(/\s+/);
const brandRest = brandRestParts.join(' ') || 'Post';
const year = new Date().getFullYear();
const zones = [
	'Downtown',
	'North Shore',
	'The Flats',
	'Millvale',
	'Eastport',
	'County',
];
const fallbackFooterGroups = [
	{ title: 'Coverage', links: ['County', 'Schools', 'Courts', 'Development'] },
	{ title: 'Newsroom', links: ['About Us', 'Our Team', 'Standards', 'Corrections'] },
	{ title: 'Reach Us', links: ['Contact Us', 'Story Tips', 'Write for Us', 'Sitemap'] },
];
---

<footer class="site-footer">
	<div class="site-wrap">
		<div class="site-footer__zones" aria-label="Coverage zones">
			{zones.map((zone, index) => (
				<a href="/blog" class="zone-link">
					<span class="zone-link__number">Zone {String(index + 1).padStart(2, '0')}</span>
					<span class="zone-link__title">{zone}</span>
				</a>
			))}
		</div>
	</div>
	<div class="site-wrap">
		<div class="site-footer__columns">
			<div class="footer-brand">
				<span class="footer-brand__name" data-tina-field={seo ? tinaField(seo, "title") : undefined}>{brandFirst}<span>{brandRest}</span></span>
				<p data-tina-field={seo ? tinaField(seo, "description") : undefined}>{seo?.description || 'An independent local newsroom covering the harbor counties. We attend the meetings, file the requests, and publish what the record shows.'}</p>
			</div>
			{footerNav.length > 0 ? (
				<div class="footer-column footer-column--wide">
					<h4>Menu</h4>
					{footerNav.map((item) => (
						<a href={item.link} data-tina-field={tinaField(item, "title")}>{item.title}</a>
					))}
				</div>
			) : fallbackFooterGroups.map((group) => (
				<div class="footer-column">
					<h4>{group.title}</h4>
					{group.links.map((link) => <a href="/blog">{link}</a>)}
				</div>
			))}
			{footerNav.length > 0 && fallbackFooterGroups.slice(1).map((group) => (
				<div class="footer-column">
					<h4>{group.title}</h4>
					{group.links.map((link) => <a href="/blog">{link}</a>)}
				</div>
			))}
		</div>
	</div>
	<div class="site-wrap">
		<div class="site-footer__bottom">
			<p>&copy; {year} {siteTitle}. Local, independent, and in the room.</p>
			<nav class="footer-legal" aria-label="Legal links">
				<a href="/">Privacy</a>
				<a href="/">Terms</a>
				<a href="/">Cookie</a>
				<a href="/">AI</a>
				<a href="/">DMCA</a>
				<a href="/">Sponsored</a>
			</nav>
		</div>
	</div>
</footer>
