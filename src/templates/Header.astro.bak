---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
	menu?: MenuDocument | null;
}

type MenuItem = {
	title?: string | null;
	link?: string | null;
	children?: (MenuItem | null)[] | null;
};

type MenuDocument = {
	title?: string | null;
	items?: (MenuItem | null)[] | null;
};

const { config, menu } = Astro.props;
const seo = config?.seo ?? null;
const menuItems = ((menu?.items ?? config?.nav ?? []) as MenuItem[]).filter((item) => item && item.title);
const siteTitle = seo?.title || 'Harbor Post';
const logo = seo?.logo || '/mockup-assets/07018032-b188-4840-96cf-12808f0a2971.png';
---

<input class="site-nav-toggle" id="site-nav-toggle" type="checkbox" aria-label="Toggle navigation menu" />
<header class="global-header global-header--demo">
	<div class="global-header__service" aria-hidden="true"></div>
	<div class="global-header__masthead">
		<div class="site-wrap global-header__masthead-inner">
			<a href="/" class="global-header__brand" aria-label={`${siteTitle} home`}>
				<img class="global-header__logo" src={logo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, "logo") : undefined} />
			</a>

			<label class="global-header__menu-button" for="site-nav-toggle">
				<span class="global-header__menu-icon"><i></i><i></i><i></i></span>
				<span>Menu</span>
			</label>

			<div class="global-header__date">
				<span>Today</span>
				<time datetime="2026-08-24">Monday, August 24, 2026</time></div>
		</div>
	</div>
	<nav class="global-header__nav" aria-label="Primary menu">
		<div class="site-wrap global-header__nav-inner">
			<a class="global-header__home-link" href="/">Home</a>
			<ul class="global-header__menu-list">
				{menuItems.length > 0 ? menuItems.map((item) => {
					const children = ((item.children ?? []) as MenuItem[]).filter((child) => child?.title && child?.link);
					const hasChildren = children.length > 0;
					return (
						<li class:list={["global-header__menu-item", { "global-header__menu-item--has-children": hasChildren }]}>
							<a href={item.link || '#'} class="global-header__menu-link" aria-haspopup={hasChildren ? 'true' : undefined} aria-expanded={hasChildren ? 'false' : undefined} data-tina-field={tinaField(item, "title")}>
								<span>{item.title}</span>
								{hasChildren && <span class="global-header__submenu-caret" aria-hidden="true">⌄</span>}
							</a>
							{hasChildren && (
								<ul class="global-header__submenu" aria-label={`${item.title} submenu`}>
									{children.map((child) => (
										<li><a href={child.link || '#'} data-tina-field={tinaField(child, "title")}>{child.title}</a></li>
									))}
								</ul>
							)}
						</li>
					);
				}) : (
					<li class="global-header__menu-item"><a class="global-header__menu-link" href="/blog">Blog</a></li>
				)}
			</ul>
		</div>
	</nav>
</header>
