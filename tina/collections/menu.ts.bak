import type { Collection } from "tinacms";

const menuItemFields = [
  {
    name: "title",
    label: "Menu Label",
    type: "string",
    required: true,
  },
  {
    name: "link",
    label: "Menu URL",
    type: "string",
    required: true,
    description: "Use # for parent dropdown items like Trending.",
  },
  {
    name: "children",
    label: "Submenu Items",
    description: "Optional dropdown links shown under this menu item.",
    type: "object",
    list: true,
    ui: {
      itemProps: (item) => ({ label: item.title }),
    },
    fields: [
      {
        name: "title",
        label: "Submenu Label",
        type: "string",
        required: true,
      },
      {
        name: "link",
        label: "Submenu URL",
        type: "string",
        required: true,
      },
    ],
  },
];

export const MenuCollection: Collection = {
  name: "menu",
  label: "Menus",
  path: "src/content/menu",
  format: "json",
  fields: [
    {
      name: "title",
      label: "Menu Name",
      type: "string",
      required: true,
      isTitle: true,
    },
    {
      name: "items",
      label: "Menu Items",
      type: "object",
      list: true,
      ui: {
        itemProps: (item) => ({ label: item.title }),
      },
      fields: menuItemFields,
    },
  ],
};
