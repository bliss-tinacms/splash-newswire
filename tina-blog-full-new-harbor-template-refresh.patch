+	display: inline-flex;
+	align-items: center;
+	justify-content: center;
+	border: 0;
+	background: var(--harbor-blue);
+	color: #fff;
+	text-decoration: none;
+	font-size: 12px;
+	font-weight: 900;
+	letter-spacing: .16em;
+	text-transform: uppercase;
+	padding: 16px 22px;
+	cursor: pointer;
+}
+
+.homepage-hero__button:hover,
+.submit-news-panel__button:hover,
+.global-footer__cta-card a:hover,
+.contact-form__button:hover { background: var(--harbor-rust); }
+
+.editorial-standards {
+	background: #fff;
+	border-bottom: 1px solid var(--harbor-line);
+}
+
+.editorial-standards__inner {
+	display: grid;
+	grid-template-columns: .85fr 1.15fr;
+	gap: 60px;
+	padding-top: 72px;
+	padding-bottom: 72px;
+}
+
+.editorial-standards__copy h2,
+.coverage-topics__header h2,
+.contact-section__header h2,
+.global-footer__cta-card h2 {
+	font-family: var(--harbor-serif);
+	font-size: clamp(2.2rem, 4vw, 3.8rem);
+	font-weight: 900;
+	letter-spacing: -.05em;
+	line-height: 1;
+	margin: 0 0 22px;
+	color: var(--harbor-navy);
+}
+
+.editorial-standards__copy p:not(.section-eyebrow),
+.coverage-topics__header p,
+.contact-section__header p {
+	font-size: 17px;
+	line-height: 1.85;
+	color: var(--harbor-muted);
+	margin: 0;
+}
+
+.editorial-standards__grid {
+	display: grid;
+	grid-template-columns: repeat(2, 1fr);
+	border: 1px solid var(--harbor-line);
+}
+
+.standard-card {
+	padding: 28px;
+	border-right: 1px solid var(--harbor-line);
+	border-bottom: 1px solid var(--harbor-line);
+}
+
+.standard-card:nth-child(2n) { border-right: 0; }
+.standard-card:nth-last-child(-n + 2) { border-bottom: 0; }
+
+.standard-card span {
+	display: block;
+	font-size: 10px;
+	font-weight: 900;
+	letter-spacing: .18em;
+	text-transform: uppercase;
+	color: var(--harbor-blue);
+	margin-bottom: 14px;
+}
+
+.standard-card h3 {
+	font-size: 18px;
+	line-height: 1.25;
+	margin: 0 0 10px;
+	color: var(--harbor-navy);
+}
+
+.standard-card p { margin: 0; color: var(--harbor-muted); line-height: 1.7; font-size: 15px; }
+
+.newsroom-board { padding: 70px 0; background: var(--harbor-sky); }
+.newsroom-board__inner { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 34px; }
+.latest-news-list, .submit-news-panel { background: #fff; border: 1px solid var(--harbor-line); }
+.latest-news-list { padding: 34px; }
+.latest-news-item { display: grid; grid-template-columns: 118px 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--harbor-line); text-decoration: none; }
+.latest-news-item:last-child { border-bottom: 0; }
+.latest-news-item__category { font-size: 10px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; color: var(--harbor-blue); }
+.latest-news-item__body strong { display: block; font-family: var(--harbor-serif); color: var(--harbor-navy); font-size: 24px; line-height: 1.12; letter-spacing: -.025em; margin-bottom: 8px; }
+.latest-news-item__body em { display: block; font-style: normal; color: var(--harbor-muted); line-height: 1.65; }
+.latest-news-item:hover strong { color: var(--harbor-blue); }
+
+.submit-news-panel { padding: 30px; align-self: start; }
+.submit-news-panel h2 { font-family: var(--harbor-serif); font-size: 30px; letter-spacing: -.04em; margin: 0 0 20px; color: var(--harbor-navy); }
+.submit-news-panel__item { display: block; text-decoration: none; padding: 18px 0; border-top: 1px solid var(--harbor-line); }
+.submit-news-panel__item strong { display: block; color: var(--harbor-navy); margin-bottom: 7px; }
+.submit-news-panel__item span { display: block; color: var(--harbor-muted); line-height: 1.6; font-size: 15px; }
+.submit-news-panel__button { width: 100%; margin-top: 20px; }
+
+.wire-feature { display: grid; grid-template-columns: 1fr 1fr; background: var(--harbor-navy); color: #fff; }
+.wire-feature__image { min-height: 460px; }
+.wire-feature__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.wire-feature__content { padding: 70px clamp(28px, 6vw, 88px); display: flex; flex-direction: column; justify-content: center; }
+.wire-feature blockquote { font-family: var(--harbor-serif); font-size: clamp(2rem, 4vw, 4rem); line-height: 1.04; letter-spacing: -.05em; margin: 0 0 28px; color: #fff; }
+.wire-feature__byline strong { display: block; color: #fff; font-size: 18px; margin-bottom: 5px; }
+.wire-feature__byline span { color: rgb(255 255 255 / 58%); font-size: 14px; }
+
+.coverage-topics { background: #fff; padding: 76px 0; }
+.coverage-topics__header { max-width: 760px; margin-bottom: 38px; }
+.coverage-topics__grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--harbor-line); }
+.coverage-topic-card { padding: 30px; min-height: 240px; border-right: 1px solid var(--harbor-line); border-bottom: 1px solid var(--harbor-line); text-decoration: none; background: #fff; transition: background .18s; }
+.coverage-topic-card:nth-child(3n) { border-right: 0; }
+.coverage-topic-card:nth-last-child(-n + 3) { border-bottom: 0; }
+.coverage-topic-card:hover { background: var(--harbor-sky); }
+.coverage-topic-card span { display: block; font-family: var(--harbor-serif); font-size: 34px; font-weight: 900; color: var(--harbor-blue); margin-bottom: 38px; }
+.coverage-topic-card h3 { color: var(--harbor-navy); font-size: 20px; line-height: 1.25; margin: 0 0 12px; }
+.coverage-topic-card p { color: var(--harbor-muted); line-height: 1.7; margin: 0; }
+
+.contact-section { background: var(--harbor-sky); padding: 76px 0; }
+.contact-section__header { max-width: 720px; margin-bottom: 34px; }
+.contact-section__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 24px; }
+.contact-card { display: block; padding: 24px; background: #fff; border: 1px solid var(--harbor-line); text-decoration: none; }
+.contact-card strong { display: block; color: var(--harbor-navy); margin-bottom: 8px; }
+.contact-card span { color: var(--harbor-muted); line-height: 1.65; font-size: 15px; }
+.contact-form { background: #fff; border: 1px solid var(--harbor-line); padding: 34px; }
+.contact-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
+.contact-form__button { width: 100%; margin-top: 8px; }
+.contact-form__note, .contact-form__setup-note { font-size: 12px; color: var(--harbor-muted); margin: 12px 0 0; line-height: 1.75; }
+.contact-form__setup-note { color: var(--harbor-rust); font-weight: 900; }
+
+.global-footer { background: var(--harbor-navy); color: #fff; }
+.global-footer__cta { display: grid; grid-template-columns: 1fr 380px; gap: 48px; padding: 72px 0; border-bottom: 1px solid var(--harbor-line-dark); }
+.global-footer__eyebrow { font-family: var(--harbor-serif); font-size: clamp(2.5rem, 5vw, 5rem); line-height: .94; letter-spacing: -.06em; margin: 0 0 22px; color: #fff; }
+.global-footer__cta-copy p:not(.global-footer__eyebrow) { color: rgb(255 255 255 / 62%); font-size: 18px; line-height: 1.8; max-width: 760px; margin: 0; }
+.global-footer__cta-card { background: rgb(255 255 255 / 6%); border: 1px solid var(--harbor-line-dark); padding: 30px; }
+.global-footer__cta-card span { display: block; font-size: 11px; color: var(--harbor-accent); font-weight: 900; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 14px; }
+.global-footer__cta-card h2 { color: #fff; font-size: 32px; }
+.global-footer__cta-card p { color: rgb(255 255 255 / 58%); line-height: 1.7; margin: 0 0 24px; }
+.global-footer__bottom { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; padding: 24px 0; }
+.global-footer__brand { color: #fff; text-decoration: none; font-family: var(--harbor-serif); font-size: 24px; font-weight: 900; letter-spacing: -.04em; }
+.global-footer__logo { display: block; max-width: 180px; max-height: 48px; object-fit: contain; }
+.global-footer__bottom p { margin: 0; color: rgb(255 255 255 / 42%); font-size: 13px; }
+.global-footer__links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 18px; }
+.global-footer__links a { color: rgb(255 255 255 / 52%); text-decoration: none; font-size: 10px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
+.global-footer__links a:hover { color: var(--harbor-accent); }
+
+@media (max-width: 980px) {
+	.global-header__masthead-inner { grid-template-columns: 1fr; text-align: center; padding: 24px 0; }
+	.global-header__menu-button, .global-header__date { justify-self: center; }
+	.global-header__date { border-left: 0; padding-left: 0; }
+	.global-header__service-inner { flex-direction: column; justify-content: center; padding: 10px 0; text-align: center; }
+	.global-header__service-text { text-align: center; }
+	.global-header__nav-inner { align-items: stretch; }
+	.global-header__menu-list { display: none; flex-direction: column; align-items: stretch; width: 100%; }
+	.global-header__home-link { flex: 1; text-align: center; }
+	.site-nav-toggle:checked ~ .global-header .global-header__nav-inner { flex-direction: column; }
+	.site-nav-toggle:checked ~ .global-header .global-header__menu-list { display: flex; }
+	.global-header__home-link, .global-header__menu-list a { border-right: 1px solid var(--harbor-line); text-align: center; }
+	.homepage-hero { min-height: 500px; }
+	.editorial-standards__inner, .newsroom-board__inner, .wire-feature, .global-footer__cta { grid-template-columns: 1fr; }
+	.wire-feature__image { min-height: 320px; }
+	.coverage-topics__grid, .contact-section__cards { grid-template-columns: 1fr 1fr; }
+	.coverage-topic-card:nth-child(n), .standard-card:nth-child(n) { border-right: 1px solid var(--harbor-line); border-bottom: 1px solid var(--harbor-line); }
+	.global-footer__bottom { grid-template-columns: 1fr; text-align: center; }
+	.global-footer__links { justify-content: center; }
+}
+
+@media (max-width: 640px) {
+	.global-header__wordmark { font-size: 2.5rem; }
+	.homepage-hero__content { padding: 72px 0; }
+	.editorial-standards__inner, .newsroom-board, .coverage-topics, .contact-section { padding-top: 48px; padding-bottom: 48px; }
+	.editorial-standards__grid, .coverage-topics__grid, .contact-section__cards, .contact-form__grid { grid-template-columns: 1fr; }
+	.latest-news-item { grid-template-columns: 1fr; gap: 8px; }
+	.coverage-topic-card:nth-child(n), .standard-card:nth-child(n) { border-right: 0; }
+	.contact-form, .latest-news-list, .submit-news-panel { padding: 24px; }
 }
diff --git a/src/templates/Footer.astro b/src/templates/Footer.astro
new file mode 100644
index 0000000..28db1a3
--- /dev/null
+++ b/src/templates/Footer.astro
@@ -0,0 +1,58 @@
+---
+import { tinaField } from "@tinacms/astro/tina-field";
+import type { CmsConfig, CmsConfigFooterNav } from '../lib/data';
+
+interface Props {
+	config?: CmsConfig | null;
+}
+
+const { config } = Astro.props;
+const seo = config?.seo ?? null;
+const footerNav = (config?.footerNav ?? []).filter(
+	(item): item is CmsConfigFooterNav => item !== null,
+);
+const siteTitle = seo?.title || 'Harbor Post';
+const logo = seo?.logo || '';
+const year = new Date().getFullYear();
+const fallbackFooterLinks = [
+	{ title: 'About', link: '/about' },
+	{ title: 'News', link: '/blog' },
+	{ title: 'Submit News', link: '/#contact-form' },
+	{ title: 'Contact', link: '/#contact-form' },
+];
+const footerLinks = footerNav.length > 0 ? footerNav : fallbackFooterLinks;
+---
+
+<footer class="global-footer">
+	<div class="site-wrap">
+		<section class="global-footer__cta" aria-label="Submit news call to action">
+			<div class="global-footer__cta-copy">
+				<p class="global-footer__eyebrow">Share news that matters.</p>
+				<p data-tina-field={seo ? tinaField(seo, "description") : undefined}>{seo?.description || 'From announcements and community developments to events and noteworthy updates, your story can reach readers looking for timely information.'}</p>
+			</div>
+			<div class="global-footer__cta-card">
+				<span>Have news to share?</span>
+				<h2>Put Your Story on Our Radar</h2>
+				<p>Send your announcement, story tip, or noteworthy update to the editorial team for review.</p>
+				<a href="/#contact-form">Submit your news →</a>
+			</div>
+		</section>
+	</div>
+	<div class="site-wrap">
+		<div class="global-footer__bottom">
+			<a href="/" class="global-footer__brand" aria-label={`${siteTitle} home`}>
+				{logo ? (
+					<img class="global-footer__logo" src={logo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, "logo") : undefined} />
+				) : (
+					<span data-tina-field={seo ? tinaField(seo, "title") : undefined}>{siteTitle}</span>
+				)}
+			</a>
+			<p>&copy; {year} {siteTitle}. Your news, everywhere it matters.</p>
+			<nav class="global-footer__links" aria-label="Footer menu">
+				{footerLinks.map((item) => (
+					<a href={item.link} data-tina-field={'__typename' in item ? tinaField(item, "title") : undefined}>{item.title}</a>
+				))}
+			</nav>
+		</div>
+	</div>
+</footer>
diff --git a/src/templates/FrontPage.astro b/src/templates/FrontPage.astro
new file mode 100644
index 0000000..88899fd
--- /dev/null
+++ b/src/templates/FrontPage.astro
@@ -0,0 +1,206 @@
+---
+import FormattedDate from '../components/FormattedDate.astro';
+import type { CmsBlog, CmsConfig } from '../lib/data';
+
+type Post = CmsBlog;
+
+interface Props {
+	posts: Post[];
+	config?: CmsConfig | null;
+}
+
+const { posts, config } = Astro.props;
+const seo = config?.seo ?? null;
+const contactForm = config?.contactForm ?? null;
+const formspreeEndpoint = contactForm?.formspreeEndpoint || 'https://formspree.io/f/YOUR_FORM_ID';
+const contactHeading = contactForm?.heading || 'Have news? Send it over.';
+const contactDescription = contactForm?.description || 'Submissions, corrections, and partnership inquiries all reach a person on our editorial team.';
+const contactButtonText = contactForm?.buttonText || 'Send to the newsroom';
+const contactNote = contactForm?.note || 'Read by a person during business hours. We reply to what we can pursue.';
+const contactSubject = contactForm?.subject || 'New contact form submission';
+const siteTitle = seo?.title || 'Harbor Post';
+
+function getReferenceLabel(reference: unknown) {
+	if (!reference) return null;
+	if (typeof reference === 'string') {
+		return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
+	}
+	if (typeof reference === 'object' && reference) {
+		const record = reference as { title?: string | null; name?: string | null };
+		return record.title || record.name || null;
+	}
+	return null;
+}
+
+function getPostUrl(post: Post) {
+	return `/blog/${post._sys.filename}/`;
+}
+
+function getPostTitle(post: Post) {
+	return post.title || 'Untitled story';
+}
+
+function getPostDescription(post: Post) {
+	return post.description || 'Read the latest reporting from the newsroom.';
+}
+
+const featured = posts[0] ?? null;
+const latest = posts.slice(1, 5);
+const coveragePosts = posts.slice(0, 6);
+const fallbackImage = '/blog-placeholder-1.jpg';
+const standards = [
+	['Accuracy', 'Verifiable and Corrected', 'Every factual claim should be verifiable, and errors found after publication are corrected openly on the record.'],
+	['Fairness', 'A Right of Response', 'Subjects of substantive allegations get a meaningful chance to respond before publication.'],
+	['Independence', 'Separate From Commercial', 'Coverage decisions are made on the merits of the story, not by advertisers or sponsors.'],
+	['Transparency', 'Clearly Labeled', 'News, analysis, opinion, and sponsored content are labeled clearly and kept visibly distinct.'],
+];
+const submitPrompts = [
+	['Submit Your Story', 'Got breaking news, a company announcement, local update, event, or noteworthy story?'],
+	['Get Featured', 'Send us the details and supporting information for editorial consideration.'],
+	['Reach More Readers', 'Share your news with audiences looking for timely stories and updates.'],
+];
+const coverageTopics = [
+	['01', 'National News & Politics', 'Major developments, public affairs, policy, and stories shaping the conversation.'],
+	['02', 'Business & Economy', 'Companies, markets, economic trends, industries, and consumer-facing developments.'],
+	['03', 'Technology', 'AI, digital trends, startups, innovation, and products changing how people live and work.'],
+	['04', 'Health & Science', 'Health developments, research, medical advances, wellness topics, and scientific discoveries.'],
+	['05', 'Lifestyle & Culture', 'Entertainment, food, culture, travel, and stories reflecting everyday life.'],
+	['06', 'Features & Everyday Life', 'Practical reporting, community topics, and useful features that add context.'],
+];
+---
+
+<main class="homepage-template">
+	<section class="homepage-hero" aria-labelledby="homepage-hero-title">
+		<div class="homepage-hero__media">
+			<img src={featured?.heroImage || fallbackImage} alt="" />
+		</div>
+		<div class="site-wrap">
+			<div class="homepage-hero__content">
+				<p class="homepage-hero__eyebrow">More Than the Headline</p>
+				<h1 id="homepage-hero-title">Reporting That Puts the Story in Perspective</h1>
+				<p>{seo?.description || `${siteTitle} brings clarity and context to the stories readers need to understand.`}</p>
+				<a href="/#contact-form" class="homepage-hero__button">Submit Your News</a>
+			</div>
+		</div>
+	</section>
+
+	<section class="editorial-standards" aria-labelledby="editorial-standards-title">
+		<div class="site-wrap editorial-standards__inner">
+			<div class="editorial-standards__copy">
+				<p class="section-eyebrow">Why {siteTitle}</p>
+				<h2 id="editorial-standards-title">Reporting built for the general reader.</h2>
+				<p>We publish readable, verifiable reporting for people who want the facts without losing context. Every update should explain what happened, why it matters, and what comes next.</p>
+			</div>
+			<div class="editorial-standards__grid">
+				{standards.map(([label, title, text]) => (
+					<article class="standard-card">
+						<span>{label}</span>
+						<h3>{title}</h3>
+						<p>{text}</p>
+					</article>
+				))}
+			</div>
+		</div>
+	</section>
+
+	<section class="newsroom-board" aria-labelledby="newsroom-board-title">
+		<div class="site-wrap newsroom-board__inner">
+			<div class="latest-news-list">
+				<div class="section-heading section-heading--compact">
+					<span id="newsroom-board-title">Latest from the Newsroom</span>
+					<span>Updated this morning</span>
+				</div>
+				{latest.map((post) => (
+					<a href={getPostUrl(post)} class="latest-news-item">
+						<span class="latest-news-item__category">{getReferenceLabel(post.category) || 'News'}</span>
+						<span class="latest-news-item__body">
+							<strong>{getPostTitle(post)}</strong>
+							<em>{getPostDescription(post)}</em>
+						</span>
+					</a>
+				))}
+			</div>
+			<aside class="submit-news-panel" aria-labelledby="submit-news-panel-title">
+				<h2 id="submit-news-panel-title">Have News to Share?</h2>
+				{submitPrompts.map(([title, text]) => (
+					<a href="/#contact-form" class="submit-news-panel__item">
+						<strong>{title}</strong>
+						<span>{text}</span>
+					</a>
+				))}
+				<a href="/#contact-form" class="submit-news-panel__button">Submit Your News</a>
+			</aside>
+		</div>
+	</section>
+
+	{featured && (
+		<section class="wire-feature" aria-label="Featured editorial quote">
+			<div class="wire-feature__image">
+				<img src={featured.heroImage || fallbackImage} alt="" />
+			</div>
+			<div class="wire-feature__content">
+				<p class="section-eyebrow">From the Wire</p>
+				<blockquote>“{getPostDescription(featured)}”</blockquote>
+				<div class="wire-feature__byline">
+					<strong>{getReferenceLabel(featured.author) || 'Editorial Team'}</strong>
+					<span>{featured.pubDate && <FormattedDate date={new Date(featured.pubDate)} />}</span>
+				</div>
+			</div>
+		</section>
+	)}
+
+	<section class="coverage-topics" aria-labelledby="coverage-topics-title">
+		<div class="site-wrap">
+			<div class="coverage-topics__header">
+				<p class="section-eyebrow">What we cover</p>
+				<h2 id="coverage-topics-title">Stories shaping the country and everyday life.</h2>
+				<p>{siteTitle} reports on major developments while delivering practical, useful context for readers.</p>
+			</div>
+			<div class="coverage-topics__grid">
+				{coverageTopics.map(([number, title, text], index) => {
+					const post = coveragePosts[index];
+					return (
+						<a href={post ? getPostUrl(post) : '/blog'} class="coverage-topic-card">
+							<span>{number}</span>
+							<h3>{post ? getPostTitle(post) : title}</h3>
+							<p>{post ? getPostDescription(post) : text}</p>
+						</a>
+					);
+				})}
+			</div>
+		</div>
+	</section>
+
+	<section class="contact-section" id="contact-form" aria-labelledby="contact-section-title">
+		<div class="site-wrap">
+			<div class="contact-section__header">
+				<p class="section-eyebrow">Get In Touch</p>
+				<h2 id="contact-section-title">{contactHeading}</h2>
+				<p>{contactDescription}</p>
+			</div>
+			<div class="contact-section__cards">
+				<a href="mailto:submit@example.com" class="contact-card"><strong>News Submissions</strong><span>Send the announcement, issuing organization, and target publish timing.</span></a>
+				<a href="mailto:corrections@example.com" class="contact-card"><strong>Corrections</strong><span>Include the article link, specific error, and correct information.</span></a>
+				<a href="mailto:info@example.com" class="contact-card"><strong>Partnerships & Office</strong><span>Advertising, syndication, technical issues, and general inquiries.</span></a>
+			</div>
+			<form class="contact-form" action={formspreeEndpoint} method="POST" accept-charset="UTF-8">
+				<input type="hidden" name="_subject" value={contactSubject} />
+				<input type="text" name="_gotcha" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
+				<div class="contact-form__grid">
