+					<label class="form-row"><span>Last Name</span><input type="text" name="last_name" placeholder="Last name" autocomplete="family-name" required /></label>
+				</div>
+				<div class="contact-form__grid">
+					<label class="form-row"><span>Email</span><input type="email" name="email" placeholder="you@example.com" autocomplete="email" required /></label>
+					<label class="form-row"><span>Phone</span><input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" /></label>
+				</div>
+				<label class="form-row"><span>Message</span><textarea name="message" placeholder="How can we help?" required></textarea></label>
+				<button class="contact-form__button" type="submit">{contactButtonText}</button>
+				<p class="contact-form__note">{contactNote}</p>
