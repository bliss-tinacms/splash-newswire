diff --git a/src/templates/Header.astro b/src/templates/Header.astro
new file mode 100644
index 0000000..1adaff5
--- /dev/null
+++ b/src/templates/Header.astro
@@ -0,0 +1,67 @@
+---
+import { tinaField } from "@tinacms/astro/tina-field";
+import type { CmsConfig } from '../lib/data';
+
+interface Props {
+	config?: CmsConfig | null;
+}
+
+const { config } = Astro.props;
+const seo = config?.seo ?? null;
+const nav = (config?.nav ?? []).filter(item => item !== null);
+const siteTitle = seo?.title || 'Harbor Post';
+const logo = seo?.logo || '';
+const today = new Intl.DateTimeFormat('en-US', {
+	weekday: 'long',
+	month: 'long',
+	day: 'numeric',
+	year: 'numeric',
+}).format(new Date());
+---
+
+<input class="site-nav-toggle" id="site-nav-toggle" type="checkbox" aria-label="Toggle navigation menu" />
+<header class="global-header">
+	<div class="global-header__service" aria-label="Site service bar">
+		<div class="site-wrap global-header__service-inner">
+			<a class="global-header__service-link" href="/blog">Submit Your News</a>
+			<span class="global-header__service-text">Independent coverage, public-interest reporting, and timely updates.</span>
+		</div>
+	</div>
+	<div class="global-header__masthead">
+		<div class="site-wrap global-header__masthead-inner">
+			<label class="global-header__menu-button" for="site-nav-toggle">
+				<span class="global-header__menu-icon"><i></i><i></i><i></i></span>
+				<span>Menu</span>
+			</label>
+
+			<a href="/" class="global-header__brand" aria-label={`${siteTitle} home`}>
+				{logo ? (
+					<img class="global-header__logo" src={logo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, "logo") : undefined} />
+				) : (
+					<span class="global-header__wordmark" data-tina-field={seo ? tinaField(seo, "title") : undefined}>{siteTitle}</span>
+				)}
+			</a>
+
+			<div class="global-header__date">
+				<span>Today</span>
+				<time datetime={new Date().toISOString()}>{today}</time>
+			</div>
+		</div>
+	</div>
+	<nav class="global-header__nav" aria-label="Primary menu">
+		<div class="site-wrap global-header__nav-inner">
+			<a class="global-header__home-link" href="/">Home</a>
+			<div class="global-header__menu-list">
+				{nav.length > 0 ? nav.map((item) => (
+					<a href={item.link} data-tina-field={tinaField(item, "title")}>{item.title}</a>
+				)) : (
+					<>
+						<a href="/blog">News</a>
+						<a href="/about">About</a>
+						<a href="/#contact-form">Contact</a>
+					</>
+				)}
+			</div>
+		</div>
+	</nav>
+</header>
