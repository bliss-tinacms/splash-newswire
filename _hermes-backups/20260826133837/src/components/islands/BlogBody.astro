---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsBlog, CmsUser } from '../../lib/data';
import FormattedDate from '../FormattedDate.astro';
import { mdxComponents } from '../mdx/components';

interface Props {
	data?: CmsBlog | null;
	relatedPosts?: CmsBlog[];
	defaultAuthor?: CmsUser | null;
}

const { data, relatedPosts = [], defaultAuthor = null } = Astro.props;

type ReferenceObject = {
	title?: string | null;
	name?: string | null;
	_sys?: { filename?: string | null } | null;
};

type AuthorObject = ReferenceObject & {
	role?: string | null;
	avatar?: string | null;
	bio?: string | null;
	email?: string | null;
};

function getReferenceLabel(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') {
		return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
	}
	if (typeof reference === 'object') {
		const item = reference as ReferenceObject;
		return String(item.title ?? item.name ?? '') || null;
	}
	return null;
}

function getReferenceSlug(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') {
		return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '') || null;
	}
	if (typeof reference === 'object') {
		const item = reference as ReferenceObject;
		return item._sys?.filename || (item.title || item.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || null;
	}
	return null;
}

function getAuthor(reference: unknown) {
	if (!reference || typeof reference !== 'object') return null;
	return reference as AuthorObject;
}

function getPostUrl(post: CmsBlog) {
	return `/blog/${post._sys.filename}/`;
}

function getPostTitle(post: CmsBlog) {
	return post.title || 'Untitled story';
}

function getPostDescription(post: CmsBlog) {
	return post.description || 'Read the full local report.';
}

const postAuthor = data ? getAuthor(data.author) : null;
const author = postAuthor || defaultAuthor;
const authorName = getReferenceLabel(author) || getReferenceLabel(data?.author) || 'Newsroom Staff';
const authorSlug = getReferenceSlug(data?.author) || getReferenceSlug(author);
const authorArchiveUrl = authorSlug ? `/blog/author/${authorSlug}/` : '/blog/';
const authorInitials = authorName.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || 'HP';

const heroImageAlt = (() => {
  const sources = [];
  if (typeof data !== 'undefined' && data) sources.push(data);
  if (typeof post !== 'undefined' && post) sources.push(post);
  if (typeof blog !== 'undefined' && blog) sources.push(blog);
  if (typeof entry !== 'undefined' && entry?.data) sources.push(entry.data);
  if (typeof frontmatter !== 'undefined' && frontmatter) sources.push(frontmatter);
  for (const item of sources) {
    const value = item?.heroImageAlt || item?.featuredImageAlt || item?.imageAlt || item?.coverImageAlt || item?.thumbnailAlt;
    if (typeof value === 'string' && value.trim()) return value.trim();
  }
  for (const item of sources) {
    const value = item?.title;
    if (typeof value === 'string' && value.trim()) return value.trim();
  }
  return 'Hero image';
})();
---

{data?.heroImage && (
	<figure data-tina-field={tinaField(data, 'heroImage')} class="single-post-hero">
		<img width={1020} height={510} src={data.heroImage} alt="" class="single-post-hero__image" />
	</figure>
)}
{data && (
	<div class="single-post-shell">
		<header class="single-post-header">
			{getReferenceLabel(data.category) && (
				<p data-tina-field={tinaField(data, 'category')} class="single-post-kicker">
					{getReferenceLabel(data.category)}
				</p>
			)}
			{data.title && <h1 data-tina-field={tinaField(data, 'title')} class="single-post-title">{data.title}</h1>}
			<div class="single-post-meta">
				<span data-tina-field={tinaField(data, 'author')}>Published by: <a href={authorArchiveUrl}>{authorName}</a></span>
				{data.pubDate && (
					<>
						<span class="single-post-meta__separator">·</span>
						<span data-tina-field={tinaField(data, 'pubDate')}>
							<FormattedDate date={new Date(data.pubDate)} />
						</span>
					</>
				)}
				{data.updatedDate && (
					<>
						<span class="single-post-meta__separator">·</span>
						<span data-tina-field={tinaField(data, 'updatedDate')} class="single-post-meta__updated">Last updated <FormattedDate date={new Date(data.updatedDate)} /></span>
					</>
				)}
			</div>
		</header>

		{data.body && (
			<div data-tina-field={tinaField(data, 'body')} class="single-post-content prose prose-lg">
				<TinaMarkdown content={data.body} components={mdxComponents} />
			</div>
		)}

		<section data-tina-field={tinaField(data, 'author')} class="post-author-box" aria-labelledby="post-author-heading">
			<a href={authorArchiveUrl} class="post-author-box__media" aria-label={`View ${authorName} archive`}>
				{author?.avatar ? (
					<img src={author.avatar} alt={authorName} width={96} height={96} class="post-author-box__photo" />
				) : (
					<span class="post-author-box__placeholder" aria-hidden="true">{authorInitials}</span>
				)}
			</a>
			<div class="post-author-box__content">
				<p class="post-author-box__label">Published by</p>
				<h2 id="post-author-heading"><a href={authorArchiveUrl}>{authorName}</a></h2>
				{author?.bio && <p class="post-author-box__bio">{author.bio}</p>}
			</div>
		</section>

	</div>
)}
{data && relatedPosts.length > 0 && (
	<section class="related-articles related-articles--full" aria-labelledby="related-articles-heading">
		<div class="site-wrap">
			<div class="related-articles__heading">
				<h2 id="related-articles-heading">Related Articles</h2>
				<span>{getReferenceLabel(data.category) || 'More stories'}</span>
			</div>
			<div class="related-articles__grid">
				{relatedPosts.slice(0, 3).map((post) => (
					<a href={getPostUrl(post)} class="related-card">
						{post.heroImage && <img src={post.heroImage} alt="" class="related-card__image" width={420} height={236} />}
						<span class="related-card__body">
							<span class="related-card__kicker">{getReferenceLabel(post.category) || 'Article'}</span>
							<span class="related-card__title">{getPostTitle(post)}</span>
							<span class="related-card__excerpt">{getPostDescription(post)}</span>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>
)}
