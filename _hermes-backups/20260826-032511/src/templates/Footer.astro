---
﻿---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig, CmsConfigFooterNav } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const footerNav = (config?.footerNav ?? []).filter(
	(item): item is CmsConfigFooterNav => item !== null,
);
const siteTitle = seo?.title || 'Harbor Post';
const logo = seo?.logo || '';
const year = new Date().getFullYear();
const fallbackFooterLinks = [
	{ title: 'About', link: '/about' },
	{ title: 'News', link: '/blog' },
	{ title: 'Submit News', link: '/#contact-form' },
	{ title: 'Contact', link: '/#contact-form' },
];
const footerLinks = footerNav.length > 0 ? footerNav : fallbackFooterLinks;
import footerNavigation from '../content/navigation/footer.json';
const footerMenuItems = (footerNavigation.items ?? []).filter((item) => item?.label && item?.href);
---

<footer class="global-footer">
	<div class="site-wrap">
		<section class="global-footer__cta" aria-label="Submit news call to action">
			<div class="global-footer__cta-copy">
				<p class="global-footer__eyebrow">Share news that matters.</p>
				<p data-tina-field={seo ? tinaField(seo, "description") : undefined}>{seo?.description || 'From announcements and community developments to events and noteworthy updates, your story can reach readers looking for timely information.'}</p>
			</div>
			<div class="global-footer__cta-card">
				<span>Have news to share?</span>
				<h2>Put Your Story on Our Radar</h2>
				<p>Send your announcement, story tip, or noteworthy update to the editorial team for review.</p>
				<a href="/#contact-form">Submit your news →</a>
			</div>
		</section>
	</div>
	<div class="site-wrap">
		<div class="global-footer__bottom">
			<a href="/" class="global-footer__brand" aria-label={`${siteTitle} home`}>
				{logo ? (
					<img class="global-footer__logo" src={logo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, "logo") : undefined} />
				) : (
					<span data-tina-field={seo ? tinaField(seo, "title") : undefined}>{siteTitle}</span>
				)}
			</a>
			<p>&copy; {year} {siteTitle}. Your news, everywhere it matters.</p>
			<div class="foot-legal">
      {footerMenuItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
		</div>
	</div>
</footer>
