---
import { getPageRouteSlug } from '../lib/permalinks';
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getPage, listPages } from '../lib/data';
import { islands } from '../lib/islands';

export async function getStaticPaths() {
	const pages = await listPages();
	return pages
		.filter((node) => node._sys.filename !== 'home')
		.map((node) => ({
			params: { slug: getPageRouteSlug(node) },
			props: { documentSlug: node._sys.filename },
		}));
}

const routeSlug = (Astro.params.slug ?? '').toString();
const documentSlug = Astro.props.documentSlug ?? routeSlug;
const page = await getPage(documentSlug);
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;
const seo = data.seo ?? null;
const title = seo?.metaTitle || data.seoTitle || config?.seo?.title || 'TinaCMS + Astro';
const description = seo?.metaDescription || config?.seo?.description || 'Welcome to my website!';
---

<Base
	title={title}
	description={description}
	image={seo?.ogImage || undefined}
	ogTitle={seo?.ogTitle || title}
	ogDescription={seo?.ogDescription || description}
	canonicalUrl={seo?.canonicalUrl || undefined}
	noindex={seo?.noindex || false}
	nofollow={seo?.nofollow || false}
>
	<TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug: documentSlug }} primary>
		<PageBody data={data} />
	</TinaIsland>
</Base>
