---
import type { CmsBlog, CmsConfig } from '../lib/data';

type Post = CmsBlog;

interface Props {
	posts: Post[];
	config?: CmsConfig | null;
}

const { posts, config } = Astro.props;
const seo = config?.seo ?? null;
const contactForm = config?.contactForm ?? null;
const formspreeEndpoint = contactForm?.formspreeEndpoint || 'https://formspree.io/f/YOUR_FORM_ID';
const contactHeading = contactForm?.heading || 'Have news? Send it over.';
const contactDescription = contactForm?.description || 'Submissions, corrections, and partnership inquiries all reach a person on our editorial team.';
const contactButtonText = contactForm?.buttonText || 'Send to the newsroom';
const contactNote = contactForm?.note || 'Read by a person during business hours. We reply to what we can pursue.';
const contactSubject = contactForm?.subject || 'New contact form submission';
const siteTitle = seo?.title || 'Harbor Post';

function getReferenceLabel(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') {
		return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
	}
	if (typeof reference === 'object' && reference) {
		const record = reference as { title?: string | null; name?: string | null };
		return record.title || record.name || null;
	}
	return null;
}

function getPostUrl(post: Post) {
	return `/blog/${post._sys.filename}/`;
}

function getPostTitle(post: Post) {
	return post.title || 'Untitled story';
}

function getPostDescription(post: Post) {
	return post.description || 'Read the latest reporting from the newsroom.';
}

const featured = posts[0] ?? null;
const latest = posts.slice(1, 5);
const coveragePosts = posts.slice(0, 6);
const fallbackImage = '/blog-placeholder-1.jpg';
const standards = [
	['Accuracy', 'Verifiable and Corrected', 'Every factual claim should be verifiable, and errors found after publication are corrected openly on the record.'],
	['Fairness', 'A Right of Response', 'Subjects of substantive allegations get a meaningful chance to respond before publication.'],
	['Independence', 'Separate From Commercial', 'Coverage decisions are made on the merits of the story, not by advertisers or sponsors.'],
	['Transparency', 'Clearly Labeled', 'News, analysis, opinion, and sponsored content are labeled clearly and kept visibly distinct.'],
];
const submitPrompts = [
	['Submit Your Story', 'Got breaking news, a company announcement, local update, event, or noteworthy story?'],
	['Get Featured', 'Send us the details and supporting information for editorial consideration.'],
	['Reach More Readers', 'Share your news with audiences looking for timely stories and updates.'],
];
const coverageTopics = [
	['01', 'National News & Politics', 'Major developments, public affairs, policy, and stories shaping the conversation.'],
	['02', 'Business & Economy', 'Companies, markets, economic trends, industries, and consumer-facing developments.'],
	['03', 'Technology', 'AI, digital trends, startups, innovation, and products changing how people live and work.'],
	['04', 'Health & Science', 'Health developments, research, medical advances, wellness topics, and scientific discoveries.'],
	['05', 'Lifestyle & Culture', 'Entertainment, food, culture, travel, and stories reflecting everyday life.'],
	['06', 'Features & Everyday Life', 'Practical reporting, community topics, and useful features that add context.'],
];
---

<main class="homepage-template">
	<section class="homepage-hero homepage-hero--demo" aria-labelledby="homepage-hero-title">
		<div class="homepage-hero__media">
			<img src="/mockup-assets/ff79aa4a-78e3-4ef4-afe8-72dd2f816909.jpg" alt="Newsroom editors reviewing national stories" />
		</div>
		<div class="site-wrap">
			<div class="homepage-hero__content">
				<p class="homepage-hero__eyebrow">More Than the Headline</p>
				<h1 id="homepage-hero-title">Reporting That Puts the Story in Perspective</h1>
				<p>Splash News Wire brings clarity and context to national developments, business, technology, health, culture, and the issues closest to everyday life.</p>
				<a href="/#contact-form" class="homepage-hero__button">Submit Your News</a>
			</div>
		</div>
	</section>

	<section class="editorial-standards" aria-labelledby="editorial-standards-title">
		<div class="site-wrap editorial-standards__inner">
			<div class="editorial-standards__copy">
        <p class="section-eyebrow">Why Splash News Wire</p>
        <h2>Reporting built for the general reader.</h2>
        <p>Splash News Wire is an independent digital news publication serving American readers, covering the events, decisions, and developments that shape daily life in the United States.</p>
        <p>The aim is coverage that is neither watered down for the sake of speed nor bloated for the sake of length, written without unnecessary jargon, and held to a plainly stated set of editorial standards.</p>
      </div>
      <div class="editorial-standards__grid">
				{standards.map(([label, title, text]) => (
					<article class="standard-card">
						<span>{label}</span>
						<h3>{title}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="newsroom-board" aria-labelledby="newsroom-board-title">
		<div class="site-wrap newsroom-board__inner">
			<div class="latest-news-list">
				<div class="section-heading section-heading--compact">
					<span id="newsroom-board-title">Latest from the Newsroom</span>
					<span>Updated this morning</span>
				</div>
				{latest.map((post) => (
					<a href={getPostUrl(post)} class="latest-news-item">
						<span class="latest-news-item__category">{getReferenceLabel(post.category) || 'News'}</span>
						<span class="latest-news-item__body">
							<strong>{getPostTitle(post)}</strong>
							<em>{getPostDescription(post)}</em>
						</span>
					</a>
				))}
			</div>
			<aside class="submit-news-panel" aria-labelledby="submit-news-panel-title">
				<h2 id="submit-news-panel-title">Have News to Share?</h2>
				{submitPrompts.map(([title, text]) => (
					<a href="/#contact-form" class="submit-news-panel__item">
						<strong>{title}</strong>
						<span>{text}</span>
					</a>
				))}
				<a href="/#contact-form" class="submit-news-panel__button">Submit Your News</a>
			</aside>
		</div>
	</section>

	<section class="wire-feature wire-feature--demo" aria-label="Featured editorial quote">
		<div class="wire-feature__image">
			<img src="/mockup-assets/4f124e1e-a72e-4a01-956d-84f01ca3d6d1.jpg" alt="Editor writing notes beside a laptop" />
		</div>
		<div class="wire-feature__content">
			<p class="section-eyebrow">From the Wire</p>
			<blockquote>Every story starts with the same standard: get the facts right, make them verifiable, and correct the record openly when we fall short.</blockquote>
			<div class="wire-feature__byline">
				<strong>Amanda Wright</strong>
				<span>Editor-in-Chief, Splash Newswire · Minneapolis · Fifteen years in editorial leadership</span>
			</div>
		</div>
	</section>

	<section class="coverage-topics what-we-cover-static" aria-labelledby="coverage-topics-title">
  <div class="site-wrap what-we-cover-static__wrap">
    <div class="what-we-cover-static__header">
      <h2>What we cover</h2>
      <p>Splash Newswire reports on the major stories shaping the country while also delivering practical, useful coverage that helps readers understand what is happening in their communities and everyday lives.</p>
    </div>

    <div class="what-we-cover-static__grid">
      <article class="what-we-cover-static__card">
        <span>01</span>
        <h3>National News &amp; Politics</h3>
        <p>Major national developments, political news, public affairs, and stories shaping the conversation across the country.</p>
      </article>
      <article class="what-we-cover-static__card">
        <span>02</span>
        <h3>Business &amp; Economy</h3>
        <p>Business developments, economic trends, companies, markets, industries, and the forces affecting consumers and communities.</p>
      </article>
      <article class="what-we-cover-static__card">
        <span>03</span>
        <h3>Technology</h3>
        <p>Technology news, AI developments, digital trends, innovation, startups, and the products changing how people live and work.</p>
      </article>
      <article class="what-we-cover-static__card">
        <span>04</span>
        <h3>Health &amp; Science</h3>
        <p>Health developments, scientific research, medical advances, wellness topics, and discoveries affecting everyday life.</p>
      </article>
      <article class="what-we-cover-static__card">
        <span>05</span>
        <h3>Lifestyle &amp; Culture</h3>
        <p>Travel, entertainment, food, culture, trends, and stories reflecting how people live, work, and spend their time.</p>
      </article>
      <article class="what-we-cover-static__card">
        <span>06</span>
        <h3>Features &amp; Everyday Life</h3>
        <p>General-interest stories, practical reporting, community topics, and useful features that put current events into perspective.</p>
      </article>
    </div>
  </div>
</section>

	<section class="contact-section get-in-touch-static" id="contact-form" aria-labelledby="contact-section-title">
  <div class="site-wrap get-in-touch-static__wrap">
    <div class="get-in-touch-static__header">
      <p class="section-eyebrow">Get In Touch</p>
      <h2>Have news? Send it over.</h2>
      <p>Submissions, corrections, and partnership inquiries all reach a person on our editorial team.</p>
      <p>Include the supporting details up front and review moves faster.</p>
    </div>

    <div class="get-in-touch-static__cards">
      <article class="get-in-touch-static__card get-in-touch-static__card--accent">
        <span class="get-in-touch-static__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
        </span>
        <h3>News Submissions</h3>
        <a href="mailto:submit@splashnewswire.com">submit@splashnewswire.com</a>
        <p>Send the announcement, the issuing organization, and when it should publish.</p>
      </article>

      <article class="get-in-touch-static__card">
        <span class="get-in-touch-static__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        </span>
        <h3>Corrections</h3>
        <a href="mailto:corrections@splashnewswire.com">corrections@splashnewswire.com</a>
        <p>Include the article link, the specific error, and the correct information.</p>
      </article>

      <article class="get-in-touch-static__card">
        <span class="get-in-touch-static__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <h3>Partnerships &amp; Office</h3>
        <a href="mailto:info@splashnewswire.com">info@splashnewswire.com</a>
        <p>Advertising, syndication partners, technical issues, and general inquiries.</p>
      </article>
    </div>
  </div>
</section>
</main>
