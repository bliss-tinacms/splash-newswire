---
import Base from '../../../layouts/Base.astro';
import { getConfig, listBlogs, type CmsBlog } from '../../../lib/data';
import { getBlogPermalink } from '../../../lib/permalinks';

const POSTS_PER_PAGE = 30;

type ReferenceObject = {
	title?: string | null;
	name?: string | null;
	_sys?: { filename?: string | null } | null;
};

function slugify(value?: string | null) {
	return (value || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

function getReferenceLabel(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
	if (typeof reference === 'object') {
		const item = reference as ReferenceObject;
		return String(item.title ?? item.name ?? '') || null;
	}
	return null;
}

function getReferenceSlug(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') return slugify(reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '') || '');
	if (typeof reference === 'object') {
		const item = reference as ReferenceObject;
		return slugify(item._sys?.filename || item.title || item.name || '');
	}
	return null;
}

function getAuthorName(reference: unknown) {
	return getReferenceLabel(reference) || 'Splash Newswire Staff';
}

function getPostUrl(post: CmsBlog) {
	return getBlogPermalink(post) + '/';
}

function parseArchiveParam(value?: string) {
	const parts = (value || '').toLowerCase().split('/').filter(Boolean);
	const pageIndex = parts.indexOf('page');
	if (pageIndex >= 0) {
		return {
			slug: parts.slice(0, pageIndex).join('/'),
			page: Math.max(1, Number(parts[pageIndex + 1] || '1') || 1),
		};
	}
	return { slug: parts.join('/'), page: 1 };
}

function pagePath(basePath: string, page: number) {
	return page <= 1 ? basePath + '/' : basePath + '/page/' + page + '/';
}

export async function getStaticPaths() {
	const posts = await listBlogs();
	const groups = new Map<string, { title: string; posts: CmsBlog[] }>();
	for (const post of posts) {
		const slug = getReferenceSlug(post.category);
		const title = getReferenceLabel(post.category);
		if (!slug || !title) continue;
		if (!groups.has(slug)) groups.set(slug, { title, posts: [] });
		groups.get(slug)?.posts.push(post);
	}

	const paths = [];
	for (const [slug, group] of groups.entries()) {
		const totalPages = Math.max(1, Math.ceil(group.posts.length / POSTS_PER_PAGE));
		for (let page = 1; page <= totalPages; page++) {
			paths.push({
				params: { slug: page === 1 ? slug : slug + '/page/' + page },
				props: { archiveTitle: group.title, currentPage: page, totalPages },
			});
		}
	}
	return paths;
}

const parsed = parseArchiveParam(Astro.params.slug);
const config = (await getConfig()).data?.config ?? null;
const allPosts = (await listBlogs()).filter((post) => getReferenceSlug(post.category) === parsed.slug);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const currentPage = Math.min(Math.max(1, parsed.page), totalPages);
const posts = allPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
const archiveTitle = getReferenceLabel(allPosts[0]?.category) || Astro.props.archiveTitle || 'Category';
const basePath = '/blog/category/' + parsed.slug;
const seoTitle = archiveTitle + ' Articles | ' + (config?.seo?.title || 'Splash Newswire');
const description = 'Read the latest ' + archiveTitle + ' articles from Splash Newswire.';
---

<Base title={seoTitle} description={description}>
	<main class="archive-template archive-template--category">
		<header class="ah">
			<div class="crumb"><div class="archive-w"><div class="crumb-in">
				<a href="/blog/">Blog</a>
				<i><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg></i>
				<a href="/blog/category/">Categories</a>
				<i><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg></i>
				<span>{archiveTitle}</span>
			</div></div></div>
			<div class="archive-w"><div class="ah-body">
				<div>
					<div class="ah-kick"><i></i><span>Category Archive</span></div>
					<h1>{archiveTitle}</h1>
				</div>
			</div></div>
		</header>

		<section class="grid-s"><div class="archive-w">
			<div class="pg">
				{posts.map((post) => (
					<a href={getPostUrl(post)} class="pc">
						{post.heroImage ? <div class="pc-img" style={'background-image:url(' + post.heroImage + ')'}></div> : <div class="pc-img pc-img--empty"></div>}
						<div class="pc-b">
							<div class="pc-k">{getReferenceLabel(post.category) || 'News'}</div>
							<div class="pc-t">{post.title}</div>
							{post.description && <p class="pc-x">{post.description}</p>}
							<div class="pc-m"><span class="pc-mn">{getAuthorName(post.author)}</span></div>
						</div>
					</a>
				))}
			</div>
		</div></section>

		{totalPages > 1 && (
			<nav class="pag" aria-label="Archive pagination"><div class="archive-w"><div class="pag-in">
				{currentPage > 1 && <a class="nx" href={pagePath(basePath, currentPage - 1)}>Prev</a>}
				{Array.from({ length: totalPages }).map((_, index) => {
					const page = index + 1;
					return page === currentPage ? <a class="on" href={pagePath(basePath, page)}>{page}</a> : <a href={pagePath(basePath, page)}>{page}</a>;
				})}
				{currentPage < totalPages && <a class="nx" href={pagePath(basePath, currentPage + 1)}>Next</a>}
			</div></div></nav>
		)}
	</main>
</Base>
