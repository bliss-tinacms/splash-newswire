---
import Base from '../../../layouts/Base.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getConfig, listBlogs, type CmsBlog } from '../../../lib/data';
import { getBlogPermalink } from '../../../lib/permalinks';

type ReferenceObject = {
  title?: string | null;
  name?: string | null;
  _sys?: { filename?: string | null } | null;
};

function getReferenceLabel(reference: unknown) {
  if (!reference) return null;
  if (typeof reference === 'string') {
    return reference.split('/').pop()?.replace(/.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
  }
  if (typeof reference === 'object') {
    const item = reference as ReferenceObject;
    return String(item.title ?? item.name ?? '') || null;
  }
  return null;
}

function getReferenceSlug(reference: unknown) {
  if (!reference) return null;
  if (typeof reference === 'string') return reference.split('/').pop()?.replace(/.(json|mdx?)$/, '') || null;
  if (typeof reference === 'object') {
    const item = reference as ReferenceObject;
    return item._sys?.filename || (item.title || item.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || null;
  }
  return null;
}

function getPostUrl(post: CmsBlog) {
  return getBlogPermalink(post) + '/';
}

export async function getStaticPaths() {
  const posts = await listBlogs();
  const categories = new Map<string, { name: string }>();
  for (const post of posts) {
    const slug = getReferenceSlug(post.category);
    const name = getReferenceLabel(post.category);
    if (slug && name) categories.set(slug, { name });
  }
  return [...categories.entries()].map(([slug, category]) => ({
    params: { slug },
    props: { categoryName: category.name },
  }));
}

const slug = (Astro.params.slug ?? '').toString();
const config = (await getConfig()).data?.config ?? null;
const posts = (await listBlogs()).filter((post) => getReferenceSlug(post.category) === slug);
const categoryName = getReferenceLabel(posts[0]?.category) || Astro.props.categoryName || 'Category';
const title = `{categoryName} Articles | {config?.seo?.title || 'Splash Newswire'}`.replaceAll('', '$');
const description = `Read the latest articles in {categoryName}.`.replaceAll('', '$');
---

<Base title={title} description={description}>
  <main class="category-archive">
    <div class="site-wrap">
      <header class="category-archive__header">
        <p class="section-eyebrow">Category Archive</p>
        <h1 class="single-page-title">{categoryName}</h1>
      </header>
      <section class="category-archive__posts" aria-label={`{categoryName} articles`.replaceAll('', '$')}>
        {posts.map((post) => (
          <a href={getPostUrl(post)} class="author-archive-card">
            {post.heroImage && <img src={post.heroImage} alt="" class="author-archive-card__image" width={360} height={220} />}
            <span class="author-archive-card__body">
              <span class="author-archive-card__kicker">{getReferenceLabel(post.category) || 'Article'}</span>
              <span class="author-archive-card__title">{post.title}</span>
              {post.pubDate && <span class="author-archive-card__date"><FormattedDate date={new Date(post.pubDate)} /></span>}
              {post.description && <span class="author-archive-card__excerpt">{post.description}</span>}
            </span>
          </a>
        ))}
      </section>
    </div>
  </main>
</Base>
