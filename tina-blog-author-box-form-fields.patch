From 46505e64d4838b1ee4410935349a7a93cca22fb1 Mon Sep 17 00:00:00 2001
From: Hermes Agent <hermes-agent@users.noreply.github.com>
Date: Mon, 24 Aug 2026 08:42:23 +0000
Subject: [PATCH] Update author box and contact form fields

---
 src/components/islands/BlogBody.astro |  1 -
 src/styles/global.css                 |  9 ---------
 src/templates/FrontPage.astro         | 11 +++++------
 3 files changed, 5 insertions(+), 16 deletions(-)

diff --git a/src/components/islands/BlogBody.astro b/src/components/islands/BlogBody.astro
index 7313b27..38ab1ef 100644
--- a/src/components/islands/BlogBody.astro
+++ b/src/components/islands/BlogBody.astro
@@ -125,7 +125,6 @@ const authorInitials = authorName.split(/\s+/).filter(Boolean).slice(0, 2).map((
 			<div class="post-author-box__content">
 				<p class="post-author-box__label">Published by</p>
 				<h2 id="post-author-heading"><a href={authorArchiveUrl}>{authorName}</a></h2>
-				{author?.role && <p class="post-author-box__role">{author.role}</p>}
 				{author?.bio && <p class="post-author-box__bio">{author.bio}</p>}
 			</div>
 		</section>
diff --git a/src/styles/global.css b/src/styles/global.css
index 80f1300..67d9642 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -505,15 +505,6 @@
 
 .post-author-box h2 a:hover { color: var(--harbor-blue); }
 
-.post-author-box__role {
-	margin: 6px 0 0;
-	font-size: 13px;
-	font-weight: 800;
-	letter-spacing: .12em;
-	text-transform: uppercase;
-	color: var(--harbor-blue);
-}
-
 .post-author-box__bio {
 	margin: 12px 0 0;
 	font-size: 15px;
diff --git a/src/templates/FrontPage.astro b/src/templates/FrontPage.astro
index 8164b4b..1e2160f 100644
--- a/src/templates/FrontPage.astro
+++ b/src/templates/FrontPage.astro
@@ -190,15 +190,14 @@ const accountability = [
 					<input type="hidden" name="_subject" value={contactSubject} />
 					<input type="text" name="_gotcha" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
 					<div class="reader-form__grid">
-						<label class="form-row"><span>Name</span><input type="text" name="name" placeholder="Optional" autocomplete="name" /></label>
-						<label class="form-row"><span>Neighborhood</span><input type="text" name="neighborhood" placeholder="Downtown, Eastport, county..." autocomplete="address-level2" /></label>
+						<label class="form-row"><span>First Name</span><input type="text" name="first_name" placeholder="First name" autocomplete="given-name" required /></label>
+						<label class="form-row"><span>Last Name</span><input type="text" name="last_name" placeholder="Last name" autocomplete="family-name" required /></label>
 					</div>
 					<div class="reader-form__grid">
-						<label class="form-row"><span>Email or phone</span><input type="text" name="contact" placeholder="How we can reach you" autocomplete="email" required /></label>
-						<label class="form-row"><span>Regarding</span><input type="text" name="regarding" placeholder="Tip · Correction · Inquiry" /></label>
+						<label class="form-row"><span>Email</span><input type="email" name="email" placeholder="you@example.com" autocomplete="email" required /></label>
+						<label class="form-row"><span>Phone</span><input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" /></label>
 					</div>
-					<label class="form-row"><span>Terms</span><input type="text" name="terms" placeholder="On the record · On background · Off the record" /></label>
-					<label class="form-row"><span>What you know</span><textarea name="message" placeholder="Dates, names, addresses, meetings, documents you have seen" required></textarea></label>
+					<label class="form-row"><span>Message</span><textarea name="message" placeholder="How can we help?" required></textarea></label>
 					<button class="reader-form__button" type="submit">{contactButtonText}</button>
 					<p class="reader-form__note">{contactNote}</p>
 					{formspreeEndpoint.includes('YOUR_FORM_ID') && (
-- 
